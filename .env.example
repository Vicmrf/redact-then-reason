# Redact-then-Reason environment template.
#
# Copy this file to `.env.local` in the REPO ROOT (next to this file).
# Every Vite config in packages/* sets `envDir` to the repo root, so ONE root
# `.env.local` is shared by packages/extension and packages/web-demo.
# `.env.local` is gitignored. Never commit it, and never put real values here.
#
# firebaseConfig values are a public client config (not secrets), but keep
# them in .env.local until the Firebase project is final.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check. Extension / localhost builds use the debug provider.
# Leave the token empty on first run: the side-panel DevTools console prints a
# debug token; register it in the Firebase console, then paste it into your
# .env.local (NOT here) so it stays stable across profile resets.
VITE_USE_APPCHECK_DEBUG=true
VITE_APPCHECK_DEBUG_TOKEN=

# reCAPTCHA Enterprise site key for the hosted web demo (Firebase Hosting domain only).
VITE_RECAPTCHA_ENTERPRISE_KEY=
